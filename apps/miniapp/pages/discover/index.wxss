.page {
  min-height: 100vh;
  padding: 24rpx 0 40rpx;
}

.state {
  margin-top: 40vh;
  text-align: center;
  color: #909399;
}

.card-swiper {
  height: 78vh;
}

.big-card {
  height: 100%;
  margin: 0 12rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(31, 45, 61, 0.12);
  display: flex;
  flex-direction: column;
}

.cover {
  width: 100%;
  height: 58%;
  background: #dcdfe6;
}

.cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #4a6078, #1f2d3d);
  color: #fff;
  font-size: 64rpx;
  font-weight: 600;
}

.info {
  flex: 1;
  padding: 28rpx 32rpx;
  overflow: hidden;
}

.name-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.name {
  font-size: 44rpx;
  font-weight: 600;
}

.meta {
  color: #909399;
  font-size: 24rpx;
}

.price {
  margin-top: 12rpx;
  color: #1f2d3d;
  font-size: 28rpx;
  font-weight: 500;
}

.highlight {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #606266;
}

.bio {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #909399;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.tags {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #409eff;
}

.reason {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #67c23a;
  line-height: 1.4;
}

.actions {
  margin-top: 24rpx;
  padding: 0 48rpx;
  display: flex;
  gap: 24rpx;
}

.action {
  flex: 1;
}

.like {
  background: #e6a23c;
}
