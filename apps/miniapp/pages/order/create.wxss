.page {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.sub {
  margin-top: 8rpx;
  color: #909399;
  font-size: 26rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1px solid #f0f2f5;
}

.row:last-child {
  border-bottom: none;
}

.label {
  color: #606266;
  font-size: 28rpx;
  width: 200rpx;
}

.value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #303133;
}

.input {
  height: 48rpx;
}

.quote .total {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #e6a23c;
}

.breakdown {
  margin-top: 12rpx;
  color: #909399;
  font-size: 24rpx;
  line-height: 1.5;
}

.btns {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 12rpx;
}
